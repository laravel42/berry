# Berry configuration — copy to `.env`; the server scripts read it from the repo root.
# `.env` is gitignored. Defaults are for loopback-only local development, not production.

# ─── Berry API ────────────────────────────────────────────────────────
BERRY_API_PORT=4000
APP_ENV=development
SERVICE_NAME=berry-server

# ─── Berry Postgres (durable product state) ──────────────────────────
# A PostgreSQL 16 you run. Upgrading to 17 goes through a separate instance and
# the documented dump/restore path, never an in-place data directory swap.
DATABASE_URL=postgres://berry:berry@127.0.0.1:5432/berry?sslmode=disable

# ─── Berry auth ───────────────────────────────────────────────────────
SESSION_TTL=720h
# Development-only escape hatch; the server rejects it in production.
AUTH_ALLOW_PASSWORDLESS_LOGIN=true
# Sign-in is GitHub only (Better Auth). Register a GitHub OAuth App — not the
# repository GitHub App — with callback URL http://localhost:3000/api/auth/callback/github.
# BERRY_AUTH_SECRET: at least 32 random characters (openssl rand -base64 32).
# Development falls back to a fixed, public secret; production refuses to boot without one.
BERRY_AUTH_SECRET=
BERRY_AUTH_GITHUB_CLIENT_ID=
BERRY_AUTH_GITHUB_CLIENT_SECRET=
# The GitHub App's slug — the name in https://github.com/apps/<slug>. Not a
# secret: it names a public page. It is what lets Berry offer the install that
# grants repository access when it did not create the App itself. Without it
# sign-in still works; there is simply nowhere to send anyone to grant access,
# and Berry says so instead of showing an empty repository list.
BERRY_GITHUB_APP_SLUG=
# Other origins a browser may open the app from, comma separated. A LAN
# address or a tunnel needs to be named here or sign-in is refused.
BERRY_AUTH_TRUSTED_ORIGINS=
# Seed demo tasks and projects on boot. Set to false for an empty product
# that stays empty after you delete things.
BERRY_SEED_DEMO_WORK=true
# Peer review: rejections before a person decides.
BERRY_AUTOGATE_MAX_ATTEMPTS=2
# Video rendering (Nova Reel) writes here before Berry copies the clip into an
# artifact. A real S3 bucket the Bedrock credential can read and write. Leave
# empty for speech only.
BERRY_MEDIA_VIDEO_S3_URI=

# ─── Realtime ─────────────────────────────────────────────────────────
# Per-subscriber event buffer, before a slow client is dropped. The streams
# replay from PostgreSQL, so a dropped subscriber loses nothing on reconnect.
REALTIME_BUFFER=64

# ─── Agent execution ──────────────────────────────────────────────────
# The model credential agents run on. Without it the server reports
# agentExecution false and refuses run requests rather than accepting ones it
# cannot serve. Server-side only: never mirror this into a NEXT_PUBLIC_*.
#
# BERRY_-prefixed on purpose: a stale OPENROUTER_API_KEY exported in the
# launching shell must not be picked up, and nothing exports the namespaced name.
BERRY_OPENROUTER_API_KEY=
# Used when an agent row names no model of its own. A Bedrock inference profile
# id, not an OpenRouter-style name: agents call Bedrock, and the `us.` prefix is
# the cross-region profile Anthropic models need in most regions.
#
# Haiku 4.5 is the cost/efficiency default — a third of Sonnet 4.5's price
# ($1/$5 per million against $3/$15) and still reliable at the tool-calling loop
# a run performs. Cheaper models exist (nova-micro is ~30x less) but lose a
# multi-step tool loop, and a run that fails cheaply still costs a retry.
BERRY_AGENT_DEFAULT_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# The shared secret an internal caller presents to POST /internal/runs. Empty
# turns that surface off entirely rather than leaving it open — it runs agents
# and spends money. Generate one per deployment:
#   openssl rand -base64 32
BERRY_INTERNAL_TOKEN=

# ─── Execution substrate (where an agent's commands run) ──────────────
# Unset means agents cannot run commands at all: the server installs a driver
# that refuses every call and names what is missing, rather than failing
# somewhere further in.
#
# `agentcore-runtime` invokes a deployed AgentCore Runtime by ARN (ADR-0014);
# deploy one with server-ts/sandbox/agentcore/deploy.sh. `agentcore` runs
# commands in an AWS Bedrock AgentCore Code Interpreter session. Both are
# reached with SigV4 and need no URL or token of their own — they are
# configured under the AgentCore section below (region, interpreter id, ARN).
#
# `docker` reaches a self-hosted runtime service (server-ts/sandbox/docker/)
# at BERRY_RUNTIME_URL with BERRY_RUNTIME_TOKEN; this repository no longer
# starts one for you.
BERRY_RUNTIME_DRIVER=agentcore-runtime
# Only for the `docker` driver. Must be https outside loopback: the token is
# sent every call, and an empty token makes the runtime refuse every call.
BERRY_RUNTIME_URL=
BERRY_RUNTIME_TOKEN=
# Where AgentCore reaches Berry back. localhost is unreachable from AWS: use a
# tunnel when developing locally.
BERRY_RUNTIME_CALLBACK_URL=

# AgentCore substrates, when BERRY_RUNTIME_DRIVER is agentcore(-runtime).
# Region falls back to BERRY_BEDROCK_REGION / AWS_REGION when unset.
# BERRY_AGENTCORE_REGION=us-east-1
# The managed interpreter every account has; a custom id is a sandbox built
# with your own network rules (which a run that clones from GitHub needs).
# BERRY_AGENTCORE_CODE_INTERPRETER_ID=aws.codeinterpreter.v1
# Required for agentcore-runtime: the deployed runtime to invoke.
# BERRY_AGENTCORE_RUNTIME_ARN=
# An AgentCore Memory store holding what earlier runs did on an issue. Unset
# disables recall: every run starts fresh, which is how Berry behaved before.
# BERRY_AGENTCORE_MEMORY_ID=
# Credentials for the AgentCore APIs. Unset falls back to the BERRY_BEDROCK_*
# pair, then to the AWS default chain. Never AWS_ACCESS_KEY_ID: that name is
# the artifact store's credential, which may not be an AWS one.
# BERRY_AGENTCORE_ACCESS_KEY_ID=
# BERRY_AGENTCORE_SECRET_ACCESS_KEY=

# Seals provider credentials (the GitHub token) at rest. 32 random bytes,
# base64. Empty leaves integrations off: a run then never gets a repository,
# which is a working deployment rather than one that fails at the clone.
#
# There is no default and none is generated implicitly — a key that appeared on
# its own would differ between restarts and strand every credential already
# stored. Generate with:  openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=

# --- The sandbox a run gets (`docker` driver only) ----------------------------
# Built from server-ts/sandbox/docker/Dockerfile.
BERRY_SANDBOX_IMAGE=berry-sandbox:local
BERRY_SANDBOX_WORKDIR=/workspace
# Modest on purpose: a runaway run must not be able to take the host down
# because nothing was set. Containers also run with all capabilities dropped.
BERRY_SANDBOX_MEMORY_MB=2048
BERRY_SANDBOX_CPUS=1
# A fork bomb is the cheapest way for generated code to take a host down.
BERRY_SANDBOX_PIDS=512
# Agents install packages and clone repositories. `none` turns that off.
BERRY_SANDBOX_NETWORK=bridge
# Over this ceiling the runtime answers 429, which Berry retries rather than
# recording the run as failed.
BERRY_SANDBOX_MAX_CONTAINERS=8

# ─── Berry storage (ADR-0006) ─────────────────────────────────────────
# Artifacts live in object storage, so development exercises the same S3 code
# path as deployment rather than a local filesystem that behaves differently
# under presigning.
# Caps a single object. It does not cap total artifact spend — retention is not
# yet decided (ADR-0006 follow-up).
STORAGE_MAX_BYTES=26214400
S3_BUCKET=berry-artifacts
S3_REGION=us-east-1
# Empty means AWS S3. Any S3-compatible endpoint works (usually with
# S3_USE_PATH_STYLE=true).
S3_ENDPOINT=
S3_USE_PATH_STYLE=false
# The credential the API stores artifacts with. Empty uses the AWS default chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ─── Frontend same-origin transport ───────────────────────────────────
# Copy these to frontend/.env.local when running Next.js on the host.
# BERRY_API_ORIGIN is server-only and defaults to this value in next.config.ts.
BERRY_API_ORIGIN=http://127.0.0.1:4000
# Browser-visible cross-origin development escape hatch. Leave empty to use
# same-origin rewrites. Never put credentials or upstream URLs in NEXT_PUBLIC_*.
NEXT_PUBLIC_BERRY_API_URL=
NEXT_PUBLIC_BOARD_ID=
NEXT_PUBLIC_WORKSPACE_SLUG=berry
NEXT_PUBLIC_WORKSPACE_NAME=Berry
