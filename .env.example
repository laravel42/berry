# Berry configuration — copy to `.env`; the server scripts read it from the repo root.
# `.env` is gitignored. Defaults are for loopback-only local development, not production.
# Every variable below is read by the code. Grouped by concern, in boot order.

# ─── Berry API ────────────────────────────────────────────────────────
# The server binds API_ADDR as host:port; the Dockerfile sets it and the
# default matches. Leave unset for 0.0.0.0:4000; the frontend expects :4000.
# API_ADDR=0.0.0.0:4000
APP_ENV=development
SERVICE_NAME=berry-server
# Serve GET /metrics (Prometheus). On by default.
METRICS_ENABLED=true

# ─── Postgres (durable product state) ─────────────────────────────────
# A PostgreSQL 16 you run (no container stack). Upgrading to 17 goes through a
# separate instance and the documented dump/restore path, never an in-place
# data directory swap. DATABASE_URL is the only Postgres variable the code reads.
DATABASE_URL=postgres://berry:berry@127.0.0.1:5432/berry?sslmode=disable

# ─── Auth (Better Auth, GitHub-only sign-in) ──────────────────────────
SESSION_TTL=720h
# Development-only escape hatch; the server rejects it in production.
AUTH_ALLOW_PASSWORDLESS_LOGIN=true
# At least 32 random characters (openssl rand -base64 32). Development falls
# back to a fixed public secret; production refuses to boot without one.
BERRY_AUTH_SECRET=
# The GitHub OAuth App that signs people in — not the repository GitHub App.
# Register it with callback http://localhost:3000/api/auth/callback/github.
BERRY_AUTH_GITHUB_CLIENT_ID=
BERRY_AUTH_GITHUB_CLIENT_SECRET=
# The GitHub App slug — the name in https://github.com/apps/<slug>. Not a
# secret. It only supplies the "install for repository access" link; sign-in
# works without it. A github_apps row (created by the manifest flow) wins.
BERRY_GITHUB_APP_SLUG=
# The browser-facing origin Better Auth builds callback URLs on. Separate from
# BERRY_PUBLIC_URL (the machine-to-machine API address).
BERRY_APP_URL=http://localhost:3000
# Other origins a browser may open the app from, comma separated. A LAN address
# or a tunnel must be named here or sign-in is refused.
BERRY_AUTH_TRUSTED_ORIGINS=

# ─── Realtime ─────────────────────────────────────────────────────────
# Per-subscriber event buffer, before a slow client is dropped. The streams
# replay from PostgreSQL, so a dropped subscriber loses nothing on reconnect.
REALTIME_BUFFER=64

# ─── Integrations (sealed credentials, repository connection, webhooks) ─
# Seals provider credentials (the GitHub token) at rest. 32 random bytes,
# base64 (openssl rand -base64 32). There is no default and none is generated:
# a key that appeared on its own would differ between restarts and strand every
# credential already stored. Empty leaves integrations off — a working
# deployment that just never gets a repository, rather than one that fails.
INTEGRATION_ENCRYPTION_KEY=
# Legacy repository-connection OAuth App (distinct from the sign-in App above).
# Only the fallback for a deployment with no GitHub App. Both or neither.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 'agentcore' routes GitHub API calls through the AgentCore gateway; 'legacy'
# uses the direct path. Defaults to 'agentcore'.
GITHUB_PROVIDER=agentcore
# This server's own public origin, where a provider sends the browser back.
# Behind a proxy the request host is the proxy's, so it cannot be derived.
BERRY_PUBLIC_URL=
# Shared secret GitHub signs inbound webhooks with. Empty disables the inbound
# route entirely rather than leaving an unsigned endpoint open.
BERRY_GITHUB_WEBHOOK_SECRET=
# Development only: let plugin calls reach http and private addresses. Set to 1
# to allow. In production a plugin must be a public https endpoint.
BERRY_PLUGINS_ALLOW_PRIVATE_NETWORK=

# ─── Bedrock (where models are called) ────────────────────────────────
# Bedrock is reached with SigV4 through the AWS credential chain, so what you
# configure is where, not who. A region with no usable credentials fails at the
# first call. These credentials are also reused by AgentCore and (by name) the
# S3 store; AWS_ACCESS_KEY_ID is NOT read for Bedrock on purpose.
BERRY_BEDROCK_REGION=us-east-1
BERRY_BEDROCK_ACCESS_KEY_ID=
BERRY_BEDROCK_SECRET_ACCESS_KEY=
# BERRY_BEDROCK_SESSION_TOKEN=      # only with temporary/STS creds

# ─── Agent behaviour tuning ───────────────────────────────────────────
# Default model when an agent row names none. A Bedrock inference profile id,
# not a bare model id: the `us.` cross-region prefix is what Anthropic models
# need in most regions. Haiku 4.5 is the cost/efficiency default ($1/$5 per
# million vs Sonnet's $3/$15) and reliable at the tool-calling loop a run runs.
BERRY_AGENT_DEFAULT_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# How many runs this process executes at once. Low on purpose: each run holds a
# container and a model call, so this is a cost ceiling as much as a load one.
BERRY_RUN_CONCURRENCY=2
# How many times a task stopped at its step limit carries on unattended, as long
# as each stopped run left new commits on the task branch. 0 turns it off.
BERRY_RUN_MAX_CONTINUATIONS=3
# Ceilings on the work agents hand to each other, for the whole deployment. One
# run is bounded by its step budget; a tree of tasks is not, and every
# delegation is another paid run. 0 turns a ceiling off.
# How far below the task a person filed a sub-task may sit.
BERRY_DELEGATION_MAX_DEPTH=3
# Sub-tasks (delegations, and decisions handed to a role) one run may create.
BERRY_DELEGATIONS_PER_RUN=5
# A task handed on again is refused when its last WINDOW handoffs involve fewer
# than MIN_UNIQUE_AGENTS agents: two roles passing it back and forth.
BERRY_HANDOFF_WINDOW=4
BERRY_HANDOFF_MIN_UNIQUE_AGENTS=3
# Only when the API itself runs in a container (deploy/dokploy). The containers
# it starts (previews, agent sessions) are then its siblings, not on its
# loopback: they are published on the Docker bridge address and reached by the
# name that resolves to it. Unset, both are 127.0.0.1.
# BERRY_DOCKER_PUBLISH_ADDR=172.17.0.1
# BERRY_DOCKER_HOST_ADDR=host.docker.internal
# Where preview checkouts are kept; must be the same path on the host. Unset: ~/.cache/berry/previews.
# BERRY_PREVIEW_ROOT=/var/lib/berry/previews
# Running previews of a task's pull request are addressed as
# p-<id>-<app>.<domain>. The default resolves to this machine in Chrome, Firefox
# and Edge with no setup (Safari does not resolve *.localhost). A deployment
# points a wildcard DNS record at Berry and names it here, with the scheme and
# port a browser really uses (`default` for 80/443 behind a proxy).
# BERRY_PREVIEW_DOMAIN=preview.localhost
# BERRY_PREVIEW_SCHEME=http
# BERRY_PREVIEW_PORT=
# Ceiling on one model reply, in tokens. Unset uses the runtime default (32000).
# BERRY_AGENT_MAX_TOKENS=
# Planner: plan-repair attempts and critic revision rounds. Low on purpose.
PLANNER_MAX_REPAIRS=2
PLANNER_MAX_CRITIC_ROUNDS=1
# Peer review (AutoGate): rejections before a person decides.
BERRY_AUTOGATE_MAX_ATTEMPTS=2
# s3://bucket/prefix where Nova Reel writes a rendered video before Berry copies
# it into an artifact. Empty means agents can make speech but not video.
BERRY_MEDIA_VIDEO_S3_URI=

# ─── Agent run dispatch (ADR-0014) ────────────────────────────────────
# Runs are queued, claimed under a SKIP LOCKED lease, and sent to a runtime
# image. The server picks its dispatch target from exactly one source, in order:
#   1. BERRY_AGENTCORE_RUNTIME_ARN — the deployed AgentCore Runtime in AWS,
#      reached with SigV4. The runtime runs in AWS, so BERRY_RUNTIME_CALLBACK_URL
#      must be a PUBLIC address (a tunnel in local dev).
#   2. BERRY_AGENT_RUNTIME_URL     — the same image reached over HTTP, e.g. a
#      container on this machine. Requires BERRY_RUNTIME_AUTH_TOKEN (>= 32
#      chars) or no executor is created and runs queue forever.
# With neither set, agentExecution is reported false and run requests are refused.
BERRY_AGENT_RUNTIME_URL=
# Shared bearer token for the HTTP path: Berry sends it on every dispatch and
# the standalone runtime checks it (>= 32 chars). openssl rand -base64 32.
BERRY_RUNTIME_AUTH_TOKEN=
# Where the runtime reaches the Berry API back. Machine-to-machine: the API
# (:4000), never the frontend (:3000). localhost works for a local container;
# AgentCore in AWS needs a public URL/tunnel. Null falls back to BERRY_PUBLIC_URL.
BERRY_RUNTIME_CALLBACK_URL=
# A task token's lifetime in seconds (the runtime's maxLifetime), capped at 28800.
# BERRY_TASK_TOKEN_TTL_SECONDS=28800

# AgentCore settings (dispatch target 1, and cross-run memory).
# Required for the ARN path; the runtime to invoke.
# BERRY_AGENTCORE_RUNTIME_ARN=
# Region for the AgentCore APIs. Falls back to BERRY_BEDROCK_REGION / AWS_REGION.
# BERRY_AGENTCORE_REGION=us-east-1
# The Code Interpreter to run commands in. aws.codeinterpreter.v1 is the managed
# one; a custom id is a sandbox built with your own network rules.
# BERRY_AGENTCORE_CODE_INTERPRETER_ID=aws.codeinterpreter.v1
# An AgentCore Memory store holding what earlier runs did on an issue. Unset
# disables recall: every run starts fresh.
# BERRY_AGENTCORE_MEMORY_ID=
# Credentials for the AgentCore APIs. Unset falls back to the BERRY_BEDROCK_*
# pair, then the AWS default chain. Never AWS_ACCESS_KEY_ID (the artifact store's).
# BERRY_AGENTCORE_ACCESS_KEY_ID=
# BERRY_AGENTCORE_SECRET_ACCESS_KEY=

# ─── AgentCore Gateway and Identity (GITHUB_PROVIDER=agentcore) ────────
# AgentCore Identity can hold the GitHub credential without a Gateway: set the
# provider, workload, stable user binding and browser return URL. GitHub OAuth
# Apps use USER_FEDERATION (their OAuth service has no client-credentials grant).
# The return URL must be allowed on the workload identity and route through
# Berry, which verifies the signed-in admin and completes URL-session binding.
# AWS_AGENTCORE_GITHUB_PROVIDER=
# AWS_AGENTCORE_WORKLOAD_NAME=berry
# AWS_AGENTCORE_GITHUB_FLOW=USER_FEDERATION
# AWS_AGENTCORE_GITHUB_USER_ID=
# AWS_AGENTCORE_GITHUB_RETURN_URL=http://localhost:3000/api/v1/integrations/agentcore/callback
# AWS_AGENTCORE_REGION=us-east-1
# A Gateway is optional and moves GitHub API/tool calls behind AgentCore too.
# AWS_AGENTCORE_GATEWAY_URL=
# JSON capability-to-tool overrides, when discovery naming defeats matching.
# BERRY_AGENTCORE_TOOL_MAP=

# ─── Legacy self-hosted docker runtime service ────────────────────────
# The `docker` driver and BERRY_RUNTIME_URL/TOKEN populate an `execution`
# config that the current dispatcher does NOT call — dispatch uses the two
# targets above. These variables (and BERRY_SANDBOX_* below) are consumed only
# by the standalone runtime service under server-ts/sandbox/docker/, which this
# repository no longer starts for you. Leave BERRY_RUNTIME_DRIVER unset unless
# you run that service; setting it to `docker` makes the server require the URL
# and token at boot.
# BERRY_RUNTIME_DRIVER=
# BERRY_RUNTIME_URL=
# BERRY_RUNTIME_TOKEN=
# The sandbox a run gets in that service, built from server-ts/sandbox/docker/.
# BERRY_SANDBOX_IMAGE=berry-sandbox:local
# BERRY_SANDBOX_WORKDIR=/workspace
# BERRY_SANDBOX_MEMORY_MB=2048
# BERRY_SANDBOX_CPUS=1
# BERRY_SANDBOX_PIDS=512
# BERRY_SANDBOX_NETWORK=bridge
# BERRY_SANDBOX_MAX_CONTAINERS=8

# ─── Seeding ──────────────────────────────────────────────────────────
# Seed demo tasks and projects on boot. false keeps the identity and board only.
BERRY_SEED_DEMO_WORK=true

# ─── Storage (S3 for run artifacts, ADR-0006) ─────────────────────────
# Artifacts live in object storage so development exercises the same S3 path as
# deployment. Caps a single object; does not cap total artifact spend.
STORAGE_MAX_BYTES=26214400
S3_BUCKET=berry-artifacts
S3_REGION=us-east-1
# Empty means AWS S3. Any S3-compatible endpoint works (usually with path style).
S3_ENDPOINT=
S3_USE_PATH_STYLE=false
# The credential the API stores artifacts with. Empty uses the AWS default chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ─── Frontend same-origin transport ───────────────────────────────────
# Copy these to frontend/.env.local when running Next.js on the host.
# BERRY_API_ORIGIN is server-only and defaults to this value in next.config.ts.
BERRY_API_ORIGIN=http://127.0.0.1:4000
# Browser-visible cross-origin dev escape hatch. Leave empty for same-origin
# rewrites. Never put credentials or upstream URLs in NEXT_PUBLIC_*.
NEXT_PUBLIC_BERRY_API_URL=
NEXT_PUBLIC_BOARD_ID=
NEXT_PUBLIC_WORKSPACE_SLUG=berry
NEXT_PUBLIC_WORKSPACE_NAME=Berry
