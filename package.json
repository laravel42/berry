{
   "name": "berry-circle",
   "version": "0.9.4",
   "private": false,
   "license": "AGPL-3.0-only",
   "description": "A self-hosted issue tracker whose assignees can be people or coding agents.",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/laravel42/berry.git"
   },
   "packageManager": "bun@1.4.4",
   "workspaces": [
      "frontend",
      "server-ts",
      "packages/plugin-sdk",
      "plugins/*",
      "apps/mobile",
      "apps/desktop",
      "apps/vscode"
   ],
   "scripts": {
      "prepare": "husky",
      "dev:frontend": "bun run --cwd frontend dev",
      "prepare:marketing": "bun run --cwd frontend prepare:marketing",
      "dev:mobile": "bun run --cwd apps/mobile start",
      "dev:desktop": "bun run --cwd apps/desktop dev",
      "package:desktop": "bun run --cwd apps/desktop package",
      "lint:frontend": "bun run --cwd frontend lint",
      "build:frontend": "bun run --cwd frontend build",
      "dev:server": "bun run --cwd server-ts dev",
      "dev:voice": "bun run --cwd server-ts dev:voice",
      "dev:docker": "docker compose -p berry-dev --profile dev up --build --remove-orphans dev-api dev-sessions dev-web",
      "dev:docker:down": "docker compose -p berry-dev --profile dev down",
      "typecheck:server": "bun run --cwd server-ts typecheck",
      "test:server": "bun run --cwd server-ts test",
      "db:migrate": "bun run --cwd server-ts migrate",
      "db:seed": "bun run --cwd server-ts seed",
      "db:reset": "bun run --cwd server-ts reset",
      "mail:test": "bun run --cwd server-ts mail:test",
      "runtime:build": "docker build -f server-ts/sandbox/agentcore/Dockerfile -t berry-agent-runtime server-ts",
      "runtime:docker": "bash scripts/runtime-docker.sh",
      "runtime:sessions": "bash scripts/runtime-docker.sh --per-session",
      "check:models": "python3 scripts/test_check_no_model_in_server.py && python3 scripts/check-no-model-in-server.py",
      "test:plugin-sdk": "bun run --cwd packages/plugin-sdk test",
      "typecheck:plugin-sdk": "bun run --cwd packages/plugin-sdk typecheck",
      "test:plugins": "bun run --filter './plugins/*' test",
      "typecheck:plugins": "bun run --filter './plugins/*' typecheck",
      "lock:server": "node scripts/lock-server.mjs"
   },
   "devDependencies": {
      "husky": "^9.1.7"
   },
   "trustedDependencies": [
      "@biomejs/biome",
      "@google/genai",
      "@livekit/blingfire",
      "@livekit/local-inference",
      "@parcel/watcher",
      "@swc/core",
      "better-sqlite3",
      "electron",
      "electron-builder",
      "electron-winstaller",
      "esbuild",
      "msw",
      "node-llama-cpp",
      "protobufjs",
      "sharp",
      "tree-sitter-go",
      "tree-sitter-javascript",
      "tree-sitter-python",
      "tree-sitter-rust",
      "tree-sitter-typescript",
      "unrs-resolver",
      "workerd"
   ],
   "overrides": {
      "@types/react": "19.3.0",
      "body-parser": "2.4.0",
      "proxy-addr": "2.0.8",
      "simple-git": "4.0.1",
      "@simple-git/argv-parser": "2.0.1",
      "zod@>=4.0.0 <4.6.6": "4.6.7",
      "@modelcontextprotocol/sdk": "1.32.1",
      "@modelcontextprotocol/server": "2.3.0"
   },
   "patchedDependencies": {
      "@electric-sql/pglite-socket@0.2.11": "server-ts/patches/@electric-sql__pglite-socket@0.2.11.patch"
   }
}
