{
   "name": "berry-circle",
   "version": "0.9.4",
   "private": false,
   "license": "MIT",
   "description": "A self-hosted issue tracker whose assignees can be people or coding agents.",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/laravel42/berry-circle.git"
   },
   "packageManager": "pnpm@10.12.1",
   "pnpm": {
      "onlyBuiltDependencies": [
         "@biomejs/biome",
         "@google/genai",
         "@parcel/watcher",
         "@swc/core",
         "better-sqlite3",
         "esbuild",
         "node-llama-cpp",
         "protobufjs",
         "sharp",
         "tree-sitter-go",
         "tree-sitter-javascript",
         "tree-sitter-python",
         "tree-sitter-rust",
         "tree-sitter-typescript",
         "unrs-resolver",
         "workerd"
      ],
      "peerDependencyRules": {
         "allowedVersions": {
            "eslint-plugin-import>eslint": "10",
            "eslint-plugin-jsx-a11y>eslint": "10",
            "eslint-plugin-react>eslint": "10",
            "@tobilu/qmd>typescript": "7"
         }
      }
   },
   "scripts": {
      "prepare": "husky",
      "dev:frontend": "pnpm --filter berry-frontend dev",
      "lint:frontend": "pnpm --filter berry-frontend lint",
      "build:frontend": "pnpm --filter berry-frontend build",
      "dev:server": "pnpm --filter @berry/server dev",
      "typecheck:server": "pnpm --filter @berry/server typecheck",
      "test:server": "pnpm --filter @berry/server test",
      "db:migrate": "pnpm --filter @berry/server migrate",
      "db:seed": "pnpm --filter @berry/server seed",      
      "db:reset": "pnpm --filter @berry/server reset",
      "runtime:build": "docker build -f server-ts/sandbox/agentcore/Dockerfile -t berry-agent-runtime server-ts",
      "runtime:docker": "bash scripts/runtime-docker.sh",
      "runtime:sessions": "bash scripts/runtime-docker.sh --per-session",
      "check:models": "python3 scripts/test_check_no_model_in_server.py && python3 scripts/check-no-model-in-server.py",
      "test:plugin-sdk": "pnpm --filter @berry/plugin-sdk test",
      "typecheck:plugin-sdk": "pnpm --filter @berry/plugin-sdk typecheck"
   },
   "devDependencies": {
      "husky": "^9.1.7"
   }
}