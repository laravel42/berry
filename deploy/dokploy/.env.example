# Paste into the Compose service's Environment tab in Dokploy, and fill in.

# Where Berry is served: the Cloudflare tunnel's public hostname. Cloudflare ends
# TLS, so the scheme people see is https while Traefik is spoken to in HTTP.
# Add the same host in the Domains tab: service `web`, port 3000, HTTPS off.
BERRY_SCHEME=https
BERRY_DOMAIN=dev.berry.pm

# Previews answer at p-<id>-<app>.<BERRY_PREVIEW_DOMAIN>. Cloudflare's free
# certificate covers berry.pm and *.berry.pm, one level only, so with it previews
# have to sit directly under berry.pm (README, "Preview hostnames"). The second
# line is the same name with every dot escaped, for the Traefik rule.
BERRY_PREVIEW_DOMAIN=berry.pm
BERRY_PREVIEW_DOMAIN_REGEX=berry\.pm

# Generate each once and keep them: openssl rand -base64 32 (hex for the password).
# INTEGRATION_ENCRYPTION_KEY seals every stored credential; losing it strands them.
POSTGRES_PASSWORD=
BERRY_AUTH_SECRET=
INTEGRATION_ENCRYPTION_KEY=
BERRY_RUNTIME_AUTH_TOKEN=

# Sign-in: a GitHub OAuth App with callback <BERRY_SCHEME>://<BERRY_DOMAIN>/api/auth/callback/github
BERRY_AUTH_GITHUB_CLIENT_ID=
BERRY_AUTH_GITHUB_CLIENT_SECRET=

# Models: an AWS key that may only invoke Bedrock models.
BERRY_BEDROCK_REGION=us-east-1
BERRY_BEDROCK_ACCESS_KEY_ID=
BERRY_BEDROCK_SECRET_ACCESS_KEY=

# Optional: cross-run recall and video rendering, with the Bedrock key above.
BERRY_AGENTCORE_REGION=
BERRY_AGENTCORE_MEMORY_ID=
BERRY_MEDIA_VIDEO_S3_URI=

# Run artifacts (optional): S3, or any S3-compatible store with S3_ENDPOINT.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_USE_PATH_STYLE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# The server's processor, for the agent runtime image: linux/amd64, or linux/arm64 on an ARM server.
BERRY_RUNTIME_PLATFORM=linux/amd64

# The Docker bridge's address on the host: `ip -4 addr show docker0`. 172.17.0.1 unless Docker was reconfigured.
DOCKER_BRIDGE_ADDR=172.17.0.1
