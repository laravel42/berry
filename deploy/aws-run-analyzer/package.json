{
   "name": "@berry/run-analyzer",
   "private": true,
   "version": "0.1.0",
   "description": "Reads finished Berry run transcripts with a Bedrock model and keeps the findings in DynamoDB. Not part of the pnpm workspace: install with npm in this folder.",
   "type": "module",
   "scripts": {
      "typecheck": "tsc --noEmit",
      "test": "tsx --test src/*.test.ts",
      "synth": "cdk synth --strict",
      "diff": "cdk diff",
      "deploy": "cdk deploy",
      "export": "tsx scripts/export-runs.ts"
   },
   "dependencies": {
      "@aws-sdk/client-bedrock-runtime": "^3.700.0",
      "@aws-sdk/client-cloudformation": "^3.700.0",
      "@aws-sdk/client-dynamodb": "^3.700.0",
      "@aws-sdk/client-s3": "^3.700.0",
      "@aws-sdk/lib-dynamodb": "^3.700.0",
      "aws-cdk-lib": "^2.270.0",
      "constructs": "^10.4.2",
      "postgres": "^3.4.9",
      "zod": "^4.6.5"
   },
   "devDependencies": {
      "@types/aws-lambda": "^8.10.150",
      "@types/node": "^22.0.0",
      "aws-cdk": "^2.1142.0",
      "esbuild": "^0.25.0",
      "tsx": "^4.19.0",
      "typescript": "^5.6.0"
   }
}
