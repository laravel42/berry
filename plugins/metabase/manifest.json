{
   "schemaVersion": 1,
   "key": "metabase",
   "name": "Metabase",
   "version": "1.0.0",
   "description": "Questions, dashboards, and database queries. An agent can run a saved question and explain the numbers it returns.",
   "scopes": [],
   "config": [
      {
         "key": "METABASE_HOST",
         "name": "Metabase host",
         "label": "Metabase host",
         "type": "string",
         "required": true
      },
      {
         "key": "API_KEY",
         "name": "API Key",
         "label": "Bearer token for the MCP server",
         "type": "secret",
         "required": true
      }
   ],
   "mcp": {
      "path": "/mcp",
      "offer": "all",
      "protocolVersion": "2025-03-26",
      "servers": {
         "default": "https://{metabase-host}/api/metabase-mcp"
      }
   }
}
