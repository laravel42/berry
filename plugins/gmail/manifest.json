{
   "schemaVersion": 1,
   "key": "gmail",
   "name": "Gmail",
   "version": "1.0.0",
   "description": "Reads and sends mail in Gmail. An agent can find a thread and draft or file a reply as part of the task.",
   "scopes": [],
   "config": [
      { "key": "API_KEY", "name": "Access token", "label": "Saved when you connect with Gmail.", "type": "secret", "required": false },
      { "key": "REFRESH_TOKEN", "name": "Refresh token", "label": "Saved when you connect with Gmail.", "type": "secret", "required": false }
   ],
   "mcp": {
      "path": "/mcp",
      "offer": "all",
      "auth": "oauth",
      "scopes": [
         "https://www.googleapis.com/auth/gmail.readonly",
         "https://www.googleapis.com/auth/gmail.compose"
      ],
      "authorize": {
         "access_type": "offline",
         "prompt": "consent"
      },
      "protocolVersion": "2025-03-26",
      "servers": {
         "default": "https://gmailmcp.googleapis.com/mcp/v1"
      }
   }
}
