{
   "schemaVersion": 1,
   "key": "outlook-calendar",
   "name": "Outlook Calendar",
   "version": "1.0.0",
   "description": "Events and availability on Outlook Calendar. An agent can see the schedule and add or update a meeting for the task.",
   "scopes": [],
   "config": [
      {
         "key": "TENANT_ID",
         "name": "Tenant id",
         "label": "Tenant id",
         "type": "string",
         "required": true
      },
      {
         "key": "API_KEY",
         "name": "API Key",
         "label": "Bearer token for the MCP server",
         "type": "secret",
         "required": true
      }
   ],
   "mcp": {
      "path": "/mcp",
      "offer": "all",
      "protocolVersion": "2025-03-26",
      "servers": {
         "default": "https://agent365.svc.cloud.microsoft/agents/tenants/{tenant_id}/servers/mcp_CalendarTools"
      }
   }
}
