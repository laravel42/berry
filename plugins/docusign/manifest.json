{
   "schemaVersion": 1,
   "key": "docusign",
   "name": "Docusign",
   "version": "1.0.0",
   "description": "Agreement workflows for envelopes and signatures. An agent can check a document's status and move the signing step forward.",
   "scopes": [],
   "config": [
      { "key": "ENDPOINT", "name": "Server", "label": "Which MCP server to call", "type": "array", "options": ["production", "developer"], "required": true },
      { "key": "API_KEY", "name": "API Key", "label": "Bearer token for the MCP server", "type": "secret", "required": true }
   ],
   "mcp": {
      "path": "/mcp",
      "offer": "all",
      "protocolVersion": "2025-03-26",
      "servers": {
         "production": "https://mcp.docusign.com/mcp",
         "developer": "https://mcp-d.docusign.com/mcp"
      }
   }
}
