{
   "schemaVersion": 1,
   "key": "lovable",
   "name": "Lovable",
   "version": "1.0.0",
   "description": "Creates and updates app projects. An agent can change a generated app and keep the project aligned with the task.",
   "scopes": [],
   "config": [
      {
         "key": "API_KEY",
         "name": "Access token",
         "label": "Saved when you connect with Lovable.",
         "type": "secret",
         "required": false
      },
      {
         "key": "REFRESH_TOKEN",
         "name": "Refresh token",
         "label": "Saved when you connect with Lovable.",
         "type": "secret",
         "required": false
      }
   ],
   "mcp": {
      "path": "/mcp",
      "offer": "all",
      "protocolVersion": "2025-03-26",
      "servers": {
         "default": "https://mcp.lovable.dev"
      },
      "auth": "oauth",
      "scopes": [
         "offline",
         "projects:read",
         "projects:write",
         "workspaces:read",
         "workspaces:write"
      ]
   }
}
