{
   "schemaVersion": 1,
   "key": "databricks",
   "name": "Databricks Genie",
   "version": "1.0.0",
   "description": "Asks Databricks Genie about warehouse data. An agent can pose a question and use the answer while it works through a task.",
   "scopes": [],
   "config": [
      {
         "key": "WORKSPACE_HOSTNAME",
         "name": "Workspace host",
         "label": "Workspace host",
         "type": "string",
         "required": true
      },
      {
         "key": "GENIE_SPACE_ID",
         "name": "Genie space",
         "label": "Genie space",
         "type": "string",
         "required": true
      },
      {
         "key": "API_KEY",
         "name": "API Key",
         "label": "Bearer token for the MCP server",
         "type": "secret",
         "required": true
      }
   ],
   "mcp": {
      "path": "/mcp",
      "offer": "all",
      "protocolVersion": "2025-03-26",
      "servers": {
         "default": "https://{workspace-hostname}/api/2.0/mcp/genie/{genie_space_id}"
      }
   }
}
