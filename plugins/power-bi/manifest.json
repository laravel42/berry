{
   "schemaVersion": 1,
   "key": "power-bi",
   "name": "Microsoft Power BI",
   "version": "1.0.0",
   "description": "Analysis and report authoring in Power BI. An agent can read a dataset and describe what a report is showing.",
   "scopes": [],
   "config": [
      {
         "key": "ENDPOINT",
         "name": "Server",
         "label": "Which MCP server to call",
         "type": "array",
         "options": [
            "analysis",
            "authoring"
         ],
         "required": true
      },
      {
         "key": "API_KEY",
         "name": "API Key",
         "label": "Bearer token for the MCP server",
         "type": "secret",
         "required": true
      }
   ],
   "mcp": {
      "path": "/mcp",
      "offer": "all",
      "protocolVersion": "2025-03-26",
      "servers": {
         "analysis": "https://api.fabric.microsoft.com/v1/mcp/powerbi",
         "authoring": "https://api.fabric.microsoft.com/v1/mcp/powerbi/authoring"
      }
   }
}
