{
   "schemaVersion": 1,
   "key": "amplitude",
   "name": "Amplitude",
   "version": "1.0.0",
   "description": "Queries analytics for events, charts, and funnels. An agent can check how a feature is used before it recommends a change.",
   "scopes": [],
   "config": [
      {
         "key": "ENDPOINT",
         "name": "Server",
         "label": "Which MCP server to call",
         "type": "array",
         "options": [
            "us",
            "eu"
         ],
         "required": true
      },
      {
         "key": "API_KEY",
         "name": "Access token",
         "label": "Saved when you connect with Amplitude.",
         "type": "secret",
         "required": false
      },
      {
         "key": "REFRESH_TOKEN",
         "name": "Refresh token",
         "label": "Saved when you connect with Amplitude.",
         "type": "secret",
         "required": false
      }
   ],
   "mcp": {
      "path": "/mcp",
      "offer": "all",
      "protocolVersion": "2025-03-26",
      "servers": {
         "us": "https://mcp.amplitude.com/mcp",
         "eu": "https://mcp.eu.amplitude.com/mcp"
      },
      "auth": "oauth",
      "scopes": [
         "all:read",
         "all:write"
      ]
   }
}
