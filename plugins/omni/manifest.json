{
   "schemaVersion": 1,
   "key": "omni",
   "name": "Omni",
   "version": "1.0.0",
   "description": "Analytics topics, queries, and workbooks. An agent can ask a question of the model and use the result in the task.",
   "scopes": [],
   "config": [
      {
         "key": "OMNI_HOST",
         "name": "Omni host",
         "label": "Omni host",
         "type": "string",
         "required": true
      },
      {
         "key": "API_KEY",
         "name": "API Key",
         "label": "Bearer token for the MCP server",
         "type": "secret",
         "required": true
      }
   ],
   "mcp": {
      "path": "/mcp",
      "offer": "all",
      "protocolVersion": "2025-03-26",
      "servers": {
         "default": "https://{omni-host}/mcp"
      }
   }
}
