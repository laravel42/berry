{
   "schemaVersion": 1,
   "key": "shopify",
   "name": "Shopify",
   "version": "1.0.0",
   "description": "Products, orders, and shop data on Shopify. An agent can look up the catalog and the orders a task is about.",
   "scopes": [],
   "config": [
      {
         "key": "ENDPOINT",
         "name": "Server",
         "label": "Which MCP server to call",
         "type": "array",
         "options": [
            "catalog",
            "store"
         ],
         "required": true
      },
      {
         "key": "STORE_DOMAIN",
         "name": "Store domain",
         "label": "Store domain",
         "type": "string",
         "required": true
      },
      {
         "key": "API_KEY",
         "name": "API Key",
         "label": "Bearer token for the MCP server",
         "type": "secret",
         "required": true
      }
   ],
   "mcp": {
      "path": "/mcp",
      "offer": "all",
      "protocolVersion": "2025-03-26",
      "servers": {
         "catalog": "https://catalog.shopify.com/api/ucp/mcp",
         "store": "https://{store-domain}/api/ucp/mcp"
      }
   }
}
