{
   "schemaVersion": 1,
   "key": "airtable",
   "name": "Airtable",
   "version": "1.0.0",
   "description": "Reads and updates bases and tables. An agent can find rows, change fields, and keep a base in step with the work.",
   "scopes": [],
   "config": [
      {
         "key": "API_KEY",
         "name": "Access token",
         "label": "Saved when you connect with Airtable.",
         "type": "secret",
         "required": false
      },
      {
         "key": "REFRESH_TOKEN",
         "name": "Refresh token",
         "label": "Saved when you connect with Airtable.",
         "type": "secret",
         "required": false
      }
   ],
   "mcp": {
      "path": "/mcp",
      "offer": "all",
      "protocolVersion": "2025-03-26",
      "servers": {
         "default": "https://mcp.airtable.com/mcp"
      },
      "auth": "oauth",
      "scopes": [
         "data.records:read",
         "data.records:write",
         "schema.bases:read",
         "schema.bases:write",
         "data.recordComments:read",
         "data.recordComments:write",
         "workspacesAndBases:read"
      ]
   }
}
