{
   "schemaVersion": 1,
   "key": "aws-data-analytics",
   "name": "AWS Data Analytics",
   "version": "1.0.0",
   "description": "Analytics tools for one AWS region. An agent can inspect data services and run the queries it needs while a task is open.",
   "scopes": [],
   "config": [
      {
         "key": "REGION",
         "name": "Region",
         "label": "AWS region",
         "type": "string",
         "required": true
      },
      {
         "key": "API_KEY",
         "name": "API Key",
         "label": "Bearer token for the MCP server",
         "type": "secret",
         "required": true
      }
   ],
   "mcp": {
      "path": "/mcp",
      "offer": "all",
      "protocolVersion": "2025-03-26",
      "servers": {
         "default": "https://aws-mcp.{region}.api.aws/mcp"
      }
   }
}
