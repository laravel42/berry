{
   "schemaVersion": 1,
   "key": "dropbox",
   "name": "Dropbox",
   "version": "1.0.0",
   "description": "Finds and reads files stored in Dropbox. An agent can open a document the task names and use what is inside it.",
   "scopes": [],
   "config": [
      {
         "key": "API_KEY",
         "name": "Access token",
         "label": "Saved when you connect with Dropbox.",
         "type": "secret",
         "required": false
      },
      {
         "key": "REFRESH_TOKEN",
         "name": "Refresh token",
         "label": "Saved when you connect with Dropbox.",
         "type": "secret",
         "required": false
      }
   ],
   "mcp": {
      "path": "/mcp",
      "offer": "all",
      "protocolVersion": "2025-03-26",
      "servers": {
         "default": "https://mcp.dropbox.com/mcp"
      },
      "auth": "oauth",
      "scopes": [
         "account_info.read",
         "file_requests.read",
         "file_requests.write",
         "files.content.read",
         "files.content.write",
         "files.metadata.read",
         "files.metadata.write",
         "sharing.read",
         "sharing.write"
      ]
   }
}
