{
   "schemaVersion": 1,
   "key": "dbt",
   "name": "dbt Cloud",
   "version": "1.0.0",
   "description": "Models, jobs, and docs on dbt Cloud. An agent can see how data is built and what a recent run did for the task.",
   "scopes": [],
   "config": [
      {
         "key": "ENDPOINT",
         "name": "Server",
         "label": "Which MCP server to call",
         "type": "array",
         "options": [
            "cloud",
            "dedicated"
         ],
         "required": true
      },
      {
         "key": "DBT_HOST",
         "name": "dbt host",
         "label": "Regional or dedicated dbt host",
         "type": "string",
         "required": true
      },
      {
         "key": "API_KEY",
         "name": "API Key",
         "label": "Bearer token for the MCP server",
         "type": "secret",
         "required": true
      }
   ],
   "mcp": {
      "path": "/mcp",
      "offer": "all",
      "protocolVersion": "2025-03-26",
      "servers": {
         "cloud": "https://cloud.getdbt.com/api/ai/v1/mcp",
         "dedicated": "https://{dbt-host}/api/ai/v1/mcp"
      }
   }
}
