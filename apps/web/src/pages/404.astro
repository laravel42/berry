---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---
<Layout
  title="Page not found — Berry"
  description="This path is not in the Berry workspace. It was never assigned, never run, and has nothing to review."
  robots="noindex, nofollow"
  canonical={false}
  includeJsonLd={false}
>
  <div class="page">
    <a href="#missing" class="sr">Skip to content</a>
    <Nav root="/" />
    <main id="missing" tabindex="-1">
      <div style="border-bottom: 1px solid var(--rule-section);">
        <div style="max-width: 1240px; margin: 0 auto; padding: clamp(56px, 8vw, 96px) clamp(20px, 3.4vw, 40px) clamp(64px, 9vw, 108px);">
          <div style="display: flex; align-items: center; gap: 14px; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-4);">
            <span style="color: var(--ink-4); font-variant-numeric: tabular-nums;">BER-404</span>
            <span style="width: 3px; height: 3px; background: var(--line-strong); border-radius: 50%;"></span>
            <span style="display: flex; align-items: center; gap: 7px; color: var(--accent-text);">
              <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--accent);"></span>
              not found
            </span>
          </div>

          <h1 style="margin: 26px 0 0; font-family: 'DM Serif Display', serif; font-weight: 400; font-size: clamp(38px, 5.4vw, 68px); line-height: 1.02; letter-spacing: -0.025em; text-wrap: balance; max-width: 16ch;">
            This issue was never opened<span style="color: var(--accent);">.</span>
          </h1>

          <p style="margin: 24px 0 0; max-width: 52ch; font-size: 15px; line-height: 1.7; color: var(--ink-3); text-wrap: pretty;">
            The path is not in the workspace. Nothing was assigned, nothing ran, and there is nothing to review.
          </p>

          <div style="margin-top: 28px; max-width: 720px; border: 1px solid var(--line); background: var(--surface-exec);">
            <div style="display: flex; align-items: center; gap: 10px; padding: 8px 14px; border-bottom: 1px solid var(--line); font-size: 11px; color: var(--ink-4);">
              <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--accent);"></span>
              run log
            </div>
            <div class="log-row" style="padding: 12px 14px; min-width: 0;">
              <span class="log-t">GET</span>
              <span class="log-msg" id="missing-path" style="min-width: 0; overflow-wrap: anywhere;">/</span>
              <span style="margin-left: auto; color: var(--accent-text); font-variant-numeric: tabular-nums; flex: none;">404</span>
            </div>
          </div>

          <div style="display: flex; gap: 10px; margin-top: 32px; flex-wrap: wrap;">
            <a href="/" class="btn-primary">Back to the home</a>
          </div>
        </div>
      </div>
    </main>
    <Footer />
  </div>
  <script is:inline>
    (function () {
      var el = document.getElementById('missing-path');
      if (!el) return;
      var path = location.pathname || '/';
      if (location.search) path += location.search;
      el.textContent = path;
    })();
  </script>
</Layout>
