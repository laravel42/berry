---
import { FAQ } from "../scripts/faq";

// The answers stay plain text in faq.ts so the FAQPage JSON-LD carries no markup.
// The repo mention is linkified here, at render time, for the visible copy only.
const REPO_TEXT = "github.com/laravel42/berry";
const REPO_HREF = "https://github.com/laravel42/berry";
---
<div id="faq" style="border-bottom: 1px solid var(--rule-section);">
  <div data-r="split" style="max-width: 1240px; margin: 0 auto; padding: clamp(48px, 7vw, 88px) clamp(20px, 3.4vw, 40px); display: grid; grid-template-columns: 400px minmax(0,1fr); gap: 72px;">
    <div style="display: flex; flex-direction: column; gap: 22px;">
      <div style="font-size: 11px; letter-spacing: 0.16em; color: var(--ink-4);">06 &nbsp;·&nbsp; QUESTIONS</div>
      <h2 style="margin: 0; font-weight: 400; font-family: 'DM Serif Display', serif; font-size: clamp(30px, 3.7vw, 46px); line-height: 1.12; letter-spacing: -0.02em;">The obvious<br>questions.</h2>
    </div>

    <dl style="margin: 0; display: flex; flex-direction: column; gap: 0;">
      {FAQ.map((item, i) => (
        <div style={`display: grid; grid-template-columns: minmax(0,1fr); gap: 10px; padding: ${i === 0 ? "0" : "26px"} 0 26px; ${i === FAQ.length - 1 ? "padding-bottom: 0;" : "border-bottom: 1px solid var(--line);"}`}>
          <dt style="font-family: 'DM Serif Display', serif; font-size: 21px; line-height: 1.25; letter-spacing: -0.01em; color: var(--ink);">{item.q}</dt>
          <dd style="margin: 0; font-size: 14px; line-height: 1.75; color: var(--ink-3); max-width: 62ch; text-wrap: pretty;">
            {item.a.split(REPO_TEXT).map((part, i) => (
              <Fragment>
                {i > 0 && (
                  <a href={REPO_HREF} target="_blank" rel="noopener" style="color: var(--ink-2); border-bottom: 1px solid var(--line-strong); padding-bottom: 1px;">{REPO_TEXT}</a>
                )}
                {part}
              </Fragment>
            ))}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</div>
