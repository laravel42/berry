---
import Logo from "./Logo.astro";
import GitHubIcon from "./GitHubIcon.astro";
import { getRepoFacts, relativeAge } from "../scripts/repo";

const repo = await getRepoFacts();
const signals = [
  { value: "AGPL3", label: "license", accent: true },
  { value: repo?.pushedAt ? relativeAge(repo.pushedAt) : "today", label: "last commit" },
];
---
<div id="opensource" style="border-bottom: 1px solid var(--rule-section);">
  <div style="max-width: 1240px; margin: 0 auto; padding: clamp(48px, 7vw, 88px) clamp(20px, 3.4vw, 40px);">
    <div data-r="split" style="display: grid; grid-template-columns: minmax(0,1fr) 540px; gap: 72px; align-items: start;">
      <div style="display: flex; flex-direction: column; gap: 22px;">
        <div style="font-size: 11px; letter-spacing: 0.16em; color: var(--ink-4);">07 &nbsp;·&nbsp; OPEN SOURCE</div>
        <h2 style="margin: 0; font-weight: 400; font-family: 'DM Serif Display', serif; font-size: clamp(30px, 3.7vw, 46px); line-height: 1.1; letter-spacing: -0.02em;">Built in the open.</h2>
        <p style="margin: 0; max-width: 440px; font-size: 15px; line-height: 1.75; color: var(--ink-3); text-wrap: pretty;">Berry runs on your own infrastructure with your AI subscriptions. Read the runtime, audit the permission layer, fork the scheduler. No workflow lock‑in and no proprietary agent format.</p>
        <div style="display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); max-width: 300px; margin-top: 6px;">
          {signals.map((s) => (
            <div style="background: var(--surface); padding: 14px 15px; display: flex; flex-direction: column; gap: 6px;">
              <span style={`font-size: 17px; color: ${s.accent ? "var(--accent-text)" : "var(--ink)"};`}>{s.value}</span>
              <span style="font-size: 11px; color: var(--ink-4);">{s.label}</span>
            </div>
          ))}
        </div>
      </div>

      <div style="border: 1px solid var(--line); background: var(--surface-3);">
        <div style="display: flex; align-items: center; gap: 8px; padding: 10px 16px; border-bottom: 1px solid var(--line); font-size: 11px; color: var(--ink-4);">
          <span style="width: 7px; height: 7px; border: 1px solid var(--line-strong); border-radius: 50%;"></span>
          <span style="width: 7px; height: 7px; border: 1px solid var(--line-strong); border-radius: 50%;"></span>
          <span style="width: 7px; height: 7px; border: 1px solid var(--line-strong); border-radius: 50%;"></span>
          <span style="margin-left: 8px;">~/src</span>
        </div>
        <div style="padding: 18px 18px 22px; font-size: 12.5px; line-height: 2;">
          <div><span style="color: var(--accent-text);">$</span> <span style="color: var(--ink);">git clone https://github.com/laravel42/berry</span></div>
          <div style="color: var(--ink-4);">Cloning into 'berry'... done.</div>
          <div><span style="color: var(--accent-text);">$</span> <span style="color: var(--ink);">cd berry && docker compose up ‑d</span></div>
          <div style="color: var(--ink-4);">✓ postgres &nbsp; ✓ runtime &nbsp; ✓ web</div>
          <div style="color: var(--done);">berry ready on http://localhost:3000</div>
          <div><span style="color: var(--accent-text);">$</span> <span style="width: 7px; height: 14px; background: var(--ink); display: inline-block; vertical-align: -2px; animation: berrypulse var(--blink) infinite;"></span></div>
        </div>
      </div>
    </div>
  </div>
</div>

<div style="background: oklch(70% .13 85); color: var(--surface);">
  <div style="max-width: 1240px; margin: 0 auto; padding: clamp(48px, 6vw, 76px) clamp(20px, 3.4vw, 40px); display: flex; align-items: flex-end; justify-content: space-between; gap: 60px; flex-wrap: wrap;">
    <div style="display: flex; flex-direction: column; gap: 18px;">
      <Logo size={34} stroke="#111113" fill="#8c1f30" />
      <h2 style="margin: 0; font-weight: 400; font-family: 'DM Serif Display', serif; font-size: clamp(34px, 4.2vw, 52px); line-height: 1.05; letter-spacing: -0.025em;">Give the backlog<br>somewhere to go<span style="color: var(--accent-deep);">.</span></h2>
      <div style="font-size: 13px; color: var(--band-ink-2);">Clone it, run docker compose, and assign your first task to an agent.</div>
    </div>
    <div style="display: flex; gap: 10px; padding-bottom: 6px;">
      <a href="https://github.com/laravel42/berry" target="_blank" rel="noopener" class="btn-cta" id="opensource-github-link">
        <GitHubIcon size={14} />
        View on GitHub
      </a>
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var osGithub = document.getElementById('opensource-github-link');
    if (osGithub) {
      osGithub.addEventListener('click', function () {
        window.posthog?.capture('github_cta_clicked', { location: 'open_source_section' });
      });
    }
  });
</script>
