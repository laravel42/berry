---
import Logo from "./Logo.astro";
---
<div role="contentinfo" style="background: var(--surface-3);">
  <div style="max-width: 1240px; margin: 0 auto; padding: 34px clamp(20px, 3.4vw, 40px); display: flex; align-items: center; justify-content: space-between; gap: 40px; flex-wrap: wrap; font-size: 11.5px; color: var(--ink-4);">
    <div style="display: flex; align-items: center; gap: 10px;">
      <Logo size={15} stroke="#8b8a92" strokeWidth={7} radius={14} />
      <span>BERRY · <span style="color: var(--accent-text);">OPEN SOURCE</span> · 2026</span>
    </div>
    <div class="credit">
      Crafted by <a href="https://laravel42.com/" target="_blank" rel="noopener" class="credit-name" data-tap>Laravel42</a>
    </div>
  </div>
</div>
