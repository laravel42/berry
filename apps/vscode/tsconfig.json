{
   "compilerOptions": {
      "target": "ES2022",
      "module": "Node16",
      "moduleResolution": "Node16",
      "rootDir": "src",
      "outDir": "dist",
      "strict": true,
      "noUncheckedIndexedAccess": true,
      "erasableSyntaxOnly": true,
      "sourceMap": true,
