{
   "name": "@berry/server",
   "private": true,
   "type": "module",
   "version": "0.1.0",
   "scripts": {
      "typecheck": "tsc --noEmit",
      "test": "node --test --experimental-strip-types 'src/**/*.test.ts' 'sandbox/docker/runtime/**/*.test.ts'",
      "dev": "node --watch --env-file-if-exists=../.env --experimental-strip-types src/index.ts",
      "start": "node --env-file-if-exists=../.env --experimental-strip-types src/index.ts",
      "migrate": "node --env-file-if-exists=../.env --experimental-strip-types src/migrate/index.ts",
      "seed": "node --env-file-if-exists=../.env --experimental-strip-types src/seed/index.ts",
      "reset": "node --env-file-if-exists=../.env --experimental-strip-types src/reset/index.ts"
   },
   "dependencies": {
      "@aws-sdk/client-bedrock": "^3.1134.0",
      "@aws-sdk/client-bedrock-agentcore": "^3.1134.0",
      "@aws-sdk/client-bedrock-agentcore-control": "^3.1134.0",
      "@aws-sdk/client-bedrock-runtime": "^3.1134.0",
      "@aws-sdk/client-polly": "^3.1134.0",
      "@aws-sdk/client-s3": "^3.1134.0",
      "@aws-sdk/s3-request-presigner": "^3.1134.0",
      "@hono/node-server": "^2.1.1",
      "@strands-agents/sdk": "~1.18.0",
      "better-auth": "1.7.5",
      "croner": "^10.0.1",
      "hono": "^4.13.8",
      "ioredis": "^6.0.0",
      "pg": "^8.23.0",
      "postgres": "^3.4.9",
      "zod": "^4.6.5"
   },
   "devDependencies": {
      "@types/node": "^26.6.1",
      "@types/pg": "^8.23.1",
      "fast-check": "^4.10.1",
      "typescript": "^7.0.2"
   },
   "license": "MIT"
}
